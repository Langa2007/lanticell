# Lanticell Environment Configuration (Placeholders Only)
# Copy to .env for local development. Never commit .env with real secrets.

# Control Plane API
CONTROL_API_PORT=8080
DATABASE_URL=postgres://lanticell:lanticell_dev_password@postgres:5432/lanticell?sslmode=disable
JWT_SECRET=change-me-to-a-32-byte-random-hex-string
ORIGIN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gateway Agent
GATEWAY_ID=gw-local-01
CONTROL_API_URL=http://control-api:8080
AGENT_TOKEN=change-me-gateway-agent-token
NGINX_CONFIG_DIR=/etc/nginx/conf.d
LAST_GOOD_DIR=/var/lib/lanticell/last-good

# PostgreSQL
POSTGRES_USER=lanticell
POSTGRES_PASSWORD=lanticell_dev_password
POSTGRES_DB=lanticell

# Dashboard
VITE_API_BASE_URL=http://localhost:8080
